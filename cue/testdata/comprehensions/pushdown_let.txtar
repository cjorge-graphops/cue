# Tests that a let in the body of a comprehension does not keep the
# comprehension from being pushed down. A let in the body can only be
# referred to from within the body, so a reference from outside cannot
# observe it. Counting it as adding field conjuncts made a reference to a
# sibling field run the comprehension early, evaluating its guard before
# another comprehension added a conjunct to the field the guard reads. The
# field was then finalized at its default, and the later conjunct was
# dropped without an error.
# https://cuelang.org/issue/XXXX
-- in.cue --
@experiment(try)

// The reported case.
reported: {
	x: {
		on: *false | bool
		if on {
			let v = 1
			out: v
		}
		n: 1
	}
	if x.n == 1 {
		x: on: true
	}
	@test(eq, {x: {on: true, out: 1, n: 1}})
}

// The same without the let, which was not affected.
noLet: {
	x: {
		on: *false | bool
		if on {
			out: 1
		}
		n: 1
	}
	if x.n == 1 {
		x: on: true
	}
	@test(eq, {x: {on: true, out: 1, n: 1}})
}

// A let whose value is a struct built by a comprehension.
letStruct: {
	x: {
		on: *false | bool
		if on {
			let v = {for k, _ in {a: 1} {(k): 1}}
			out: v
		}
		n: 1
	}
	if x.n == 1 {
		x: on: true
	}
	@test(eq, {x: {on: true, out: {a: 1}, n: 1}})
}

// A let referring to a field declared by the same body.
letBodyField: {
	x: {
		on: *false | bool
		if on {
			let v = out2
			out:  v
			out2: 2
		}
		n: 1
	}
	if x.n == 1 {
		x: on: true
	}
	@test(eq, {x: {on: true, out: 2, out2: 2, n: 1}})
}

// The let is in a comprehension nested in the body.
nested: {
	x: {
		on: *false | bool
		if on {
			if true {
				let v = 1
				out: v
			}
		}
		n: 1
	}
	if x.n == 1 {
		x: on: true
	}
	@test(eq, {x: {on: true, out: 1, n: 1}})
}

// The let is in a for comprehension.
forClause: {
	x: {
		on: *false | bool
		for _, e in {a: 1} if on {
			let v = e
			out: v
		}
		n: 1
	}
	if x.n == 1 {
		x: on: true
	}
	@test(eq, {x: {on: true, out: 1, n: 1}})
}

// The let is in the else clause.
elseClause: {
	x: {
		on: *false | bool
		if !on {
			out: 1
		} else {
			let v = 2
			out: v
		}
		n: 1
	}
	if x.n == 1 {
		x: on: true
	}
	@test(eq, {x: {on: true, out: 2, n: 1}})
}
-- out/eval/stats --
Leaks:  19
Freed:  52
Reused: 39
Allocs: 32
Retain: 0

Unifications: 51
Conjuncts:    104
Disjuncts:    14

NumCloseIDs: 8
