# Tests that a let in the body of a comprehension does not keep the
# comprehension from being pushed down. A let in the body can only be
# referred to from within the body, so a reference from outside cannot
# observe it. Counting it as adding field conjuncts made a reference to a
# sibling field run the comprehension early, evaluating its guard before
# another comprehension added a conjunct to the field the guard reads. The
# field was then finalized at its default, and the later conjunct was
# dropped without an error.
# https://cuelang.org/issue/XXXX
-- in.cue --
@experiment(try)

// The reported case.
reported: {
	x: {
		on: *false | bool
		if on {
			let v = 1
			out: v
		}
		n: 1
	}
	if x.n == 1 {
		x: on: true
	}
}

// The same without the let, which was not affected.
noLet: {
	x: {
		on: *false | bool
		if on {
			out: 1
		}
		n: 1
	}
	if x.n == 1 {
		x: on: true
	}
}

// A let whose value is a struct built by a comprehension.
letStruct: {
	x: {
		on: *false | bool
		if on {
			let v = {for k, _ in {a: 1} {(k): 1}}
			out: v
		}
		n: 1
	}
	if x.n == 1 {
		x: on: true
	}
}

// A let referring to a field declared by the same body.
letBodyField: {
	x: {
		on: *false | bool
		if on {
			let v = out2
			out:  v
			out2: 2
		}
		n: 1
	}
	if x.n == 1 {
		x: on: true
	}
}

// The let is in a comprehension nested in the body.
nested: {
	x: {
		on: *false | bool
		if on {
			if true {
				let v = 1
				out: v
			}
		}
		n: 1
	}
	if x.n == 1 {
		x: on: true
	}
}

// The let is in a for comprehension.
forClause: {
	x: {
		on: *false | bool
		for _, e in {a: 1} if on {
			let v = e
			out: v
		}
		n: 1
	}
	if x.n == 1 {
		x: on: true
	}
}

// The let is in the else clause.
elseClause: {
	x: {
		on: *false | bool
		if !on {
			out: 1
		} else {
			let v = 2
			out: v
		}
		n: 1
	}
	if x.n == 1 {
		x: on: true
	}
}

// An embedded let can declare fields that are not known in advance, so the
// comprehension is still not pushed down, and the conjunct is still
// dropped, as it is with a dynamic field, a pattern constraint or ... in the
// body instead.
letEmbed: {
	x: {
		on: *false | bool
		if on {
			let v = {out: 1}
			v
		}
		n: 1
	}
	if x.n == 1 {
		x: on: true
	}
}

// Issue 4487 with a let in the guarded body. The guard reads a list built
// by a comprehension over a struct whose comprehensions yield nothing.
issue4487: {
	empty: {
		q: {
			a: 0
			if false {b: 1}
			if false {c: 2}
		}
		n: [if len(q) > 1 {q}]
		if len(n) == 0 {
			let m = "empty"
			out: m
		}
	}
	populated: {
		q: {
			a: 0
			b: 1
			if false {c: 2}
			if false {d: 3}
		}
		n: [if len(q) > 1 {q}]
		if len(n) != 0 {
			let m = n
			out: m
		}
	}
}
-- issue4448.cue --
import (
	"list"
	"strings"
)

// Issue 4448 with a let in the guarded body. The let kept the comprehension
// from being pushed down, so looking up _port forced its guard again, which
// left the "\(port)" interpolation incomplete. As in issue4448.txtar, the
// test is sensitive to evaluation order; _s and m are needed to trigger the
// failure.
issue4448: {
	_s: strings.ToLower("A")

	#App: {
		units: {_elem: {
			spec: {src: string, tags: _} | {tags: _}
			if spec != _|_ {
				let v = 1
				_w: v
			}
		}}
		m: units._elem
	}

	#Mixin: {
		#cfg: {
			entries: w: {
				_lines: ["\(port)"]
				port: _
			}
			_all: list.Concat([entries.w._lines])
		}

		...
	}

	app: #App
	app: #Mixin
	app: {
		#cfg: entries: w: {
			port: units._elem._port
		}
		units: _elem: {
			_port: 8080
			spec: {
				src: "x"
				tags: [#cfg._all]
			}
		}
	}
}
-- out/compile --
